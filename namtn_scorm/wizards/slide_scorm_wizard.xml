<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View slide.scorm.wizard form -->
    <record id="view_slide_scorm_wizard_form" model="ir.ui.view">
        <field name="name">view.slide.scorm.wizard.form</field>
        <field name="model">slide.scorm.wizard</field>
        <field name="arch" type="xml">
            <form string="Slide Scorm Wizard">
                <group>
                    <field name="slide_channel_id" readonly="1" force_save="1" />
                    <field name="scorm_file" filename="scorm_filename" widget="many2many_binary" />
                    <field name="override_channel" widget="boolean_toggle" />
                </group>
                <footer>
                    <button name="action_import_scorm" type="object" string="Import"
                        class="oe_highlight" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action slide.scorm.wizard -->
    <record id="action_slide_scorm_wizard" model="ir.actions.act_window">
        <field name="name">Slide Scorm Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">slide.scorm.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="namtn_scorm.model_slide_scorm_wizard" />
        <field name="target">new</field>
    </record>

</odoo>