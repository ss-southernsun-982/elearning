<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="slide_channel_view_form_inherit_scorm" model="ir.ui.view">
        <field name="name">slide.channel.form.inherit.scorm</field>
        <field name="model">slide.channel</field>
        <field name="inherit_id" ref="website_slides.view_slide_channel_form" />
        <field name="arch" type="xml">
            <xpath expr="//form//header" position="inside">
                <button name="action_import_scorm" string="Import SCORM Slides" type="object"
                    class="oe_highlight" />
            </xpath>
        </field>
    </record>
</odoo>